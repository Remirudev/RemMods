{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "linux": {
      "deb": {
        "depends": ["libc6 (>= 2.39)", "libssl3t64 | libssl3", "xdg-utils"],
        "desktopTemplate": "linux/remmods.desktop",
        "files": {
          "/usr/share/doc/remmods/THIRD-PARTY-NOTICES": "../THIRD-PARTY-NOTICES",
          "/usr/share/doc/remmods/THIRD-PARTY-NOTICES-NPM": "../THIRD-PARTY-NOTICES-NPM"
        }
      },
      "rpm": {
        "depends": ["libc.so.6(GLIBC_2.39)(64bit)", "libssl.so.3()(64bit)", "xdg-utils"],
        "desktopTemplate": "linux/remmods.desktop",
        "files": {
          "/usr/share/doc/remmods/THIRD-PARTY-NOTICES": "../THIRD-PARTY-NOTICES",
          "/usr/share/doc/remmods/THIRD-PARTY-NOTICES-NPM": "../THIRD-PARTY-NOTICES-NPM"
        }
      },
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/share/doc/remmods/THIRD-PARTY-NOTICES": "../THIRD-PARTY-NOTICES",
          "/usr/share/doc/remmods/THIRD-PARTY-NOTICES-NPM": "../THIRD-PARTY-NOTICES-NPM"
        }
      }
    }
  }
}
