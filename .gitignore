# Dependencies and build output
node_modules/
dist/
target/
src-tauri/gen/schemas/
# Regenerated by tauri-build on every build from the command list in src-tauri/build.rs.
src-tauri/permissions/autogenerated/
*.tsbuildinfo
vite.config.*.timestamp-*
coverage/
# Python bytecode of the release scripts when one is imported by another script or a test
__pycache__/

# Logs
*.log
npm-debug.log*

# User-local files (Paks snapshots, scratch notes)
local/

# Environment files
.env
.env.*
!.env.example
*.local

# JetBrains: per-user files only, so shared .idea config can be committed
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.local.xml
.idea/contentModel.xml
.idea/**/aws.xml
.idea/copilot*

# Claude Code per-user state
.claude/settings.local.json
.claude/.cc-writes/

# OS clutter
.DS_Store
Thumbs.db
