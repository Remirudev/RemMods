{
  "name": "remmods",
  "private": true,
  "version": "0.1.0",
  "description": "Mod manager for TEKKEN 8",
  "repository": {
    "type": "git",
    "url": "https://github.com/Remirudev/RemMods"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:serve": "vite --mode e2e --host 127.0.0.1 --port 1431 --strictPort",
    "bindings": "cargo run --locked -p remmods --bin export-bindings --features bindings"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/modals": "9.7.4",
    "@mantine/notifications": "9.7.4",
    "@mantine/spotlight": "9.7.4",
    "@tabler/icons-react": "3.50.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.24",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-log": "2.10.1",
    "i18next": "26.5.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
