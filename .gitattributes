# LF everywhere, also in Windows checkouts (rustfmt, Biome and the bindings diff expect it).
* text=auto eol=lf

# Binaries
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.7z binary
*.rar binary
*.pak binary
*.ucas binary
*.utoc binary

# Generated by `npm run bindings`; committed, collapsed in diffs.
src/lib/ipc/bindings.ts linguist-generated=true

# Golden and interop fixtures are compared byte for byte: no line-ending conversion.
**/fixtures/** -text
**/golden/** -text
